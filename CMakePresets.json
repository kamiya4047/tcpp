{
  "version": 6,
  "configurePresets": [
    {"name": "windows", "generator": "Visual Studio 17 2022", "architecture": "x64", "binaryDir": "${sourceDir}/build/windows", "cacheVariables": {"IME_WARNINGS_AS_ERRORS": "ON"}},
    {"name": "portable", "generator": "Ninja", "binaryDir": "${sourceDir}/build/portable", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "IME_BUILD_WINDOWS_TSF": "OFF"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug"},
    {"name": "release", "configurePreset": "windows", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
